                  "  pm.response.to.have.status(200);",
                  "  pm.expect(body).to.have.property('result');",
                  "});",
                  "const r = body.result || {};",
                  "const sc = r.structuredContent || {};",
                  "pm.test('tool did not fail', () => pm.expect(r.isError).to.eql(false));",
                  "if (sc.contextId) pm.collectionVariables.set('contextId', sc.contextId);",
                  "pm.collectionVariables.set('taskId', sc.taskId || '');",
                  "pm.collectionVariables.set('state', sc.state || '');",
                  "console.log('state=' + sc.state + ' contextId=' + sc.contextId + ' taskId=' + sc.taskId);",
                  "console.log((r.content || []).map(c => c.text).join('\\n\\n'));",
                  "",
                  "pm.test('state is one of ['completed']', () => pm.expect([\"completed\"]).to.include(sc.state));",
                  "",
                  "pm.test('three buildings', () => { const t = JSON.stringify(r.content); ['2418','2419','2420'].forEach(b => pm.expect(t).to.include(b)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "No context_id: a new conversation, so the response has a new contextId. Expected: 2418, 2419, 2420.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"1\",\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"ask_agent\",\n    \"arguments\": {\n      \"message\": \"Which buildings does Finance & Accounting occupy?\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{mcpUrl}}",
              "host": [
                "{{mcpUrl}}"
              ]
            }
