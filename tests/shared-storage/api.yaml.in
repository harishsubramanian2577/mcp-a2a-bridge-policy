#
# Two API instances with the same policy and the same Redis. "hr" binds sessions to the
# x-client-id header; "finance" does not. run.sh writes config/api.yaml from this file with POLICY_REF replaced.
---
apiVersion: gateway.mulesoft.com/v1alpha1
kind: ApiInstance
metadata:
  name: hr-agent
spec:
  address: http://0.0.0.0:8081/hr
  services:
    upstream:
      address: http://agent:8080
      routes:
        - config:
            destinationPath: /
  policies:
    - policyRef:
        name: POLICY_REF
      config:
        toolName: ask_agent
        a2aProtocolVersion: "1.0"
        passThroughA2A: false
        a2aPath: ""
        sessionStoreMode: remote
        sessionTtlSeconds: 600
        sessionKeyHeader: x-client-id
---
apiVersion: gateway.mulesoft.com/v1alpha1
kind: ApiInstance
metadata:
  name: finance-agent
spec:
  address: http://0.0.0.0:8082/finance
  services:
    upstream:
      address: http://agent:8080
      routes:
        - config:
            destinationPath: /
  policies:
    - policyRef:
        name: POLICY_REF
      config:
        toolName: ask_agent
        a2aProtocolVersion: "1.0"
        passThroughA2A: false
        a2aPath: ""
        sessionStoreMode: remote
        sessionTtlSeconds: 600
